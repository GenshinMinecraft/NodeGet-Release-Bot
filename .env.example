# Required
WEBHOOK_SECRET=replace-with-openssl-rand-hex-32
REPO_DIR=/root/NodeGet
GITHUB_REPO=owner/NodeGet

# Server
HOST=127.0.0.1
PORT=8787
WEBHOOK_PATH=/nodeget-release-webhook

# Build
RUST_TOOLCHAIN=nightly
BUILD_CONCURRENCY=8
CROSS_JOBS=8
CLEAN_BUILD=0
ENABLE_UPX=1
BUILD_TARGET_SET=all
ALLOW_PARTIAL=1
